# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never ship it to the
# browser. Used by scripts/seed-users.mjs to create sample auth users, and at
# runtime by the Admin Panel's Master Data page (src/lib/supabase/admin.ts)
# to create/deactivate users and change login emails via the Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password assigned to every seeded sample user (change for real deployments).
SEED_USER_PASSWORD=ChangeMe123!

# Base URL used to build the magic-link redirect target.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
